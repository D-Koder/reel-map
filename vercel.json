{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/scrape-location.js": {
      "maxDuration": 120
    },
    "api/listed-place.js": {
      "maxDuration": 120
    },
    "api/enrich-reel.js": {
      "maxDuration": 120
    },
    "api/save-reel.js": {
      "maxDuration": 120
    },
    "api/share-image.js": {
      "includeFiles": "api/_lib/fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/share-page?id=:id"
    }
  ]
}
