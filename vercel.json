{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/scrape-reel.js": {
      "maxDuration": 30
    },
    "api/scrape-location.js": {
      "maxDuration": 60
    },
    "api/enrich-reel.js": {
      "maxDuration": 120
    }
  }
}