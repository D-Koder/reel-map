# Copy to frontend/.env.local for local frontend development
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Optional: error reports to Sentry (api/_lib/report-error.js). Use the project DSN from Sentry.
# SENTRY_DSN=

# Optional: Google Places for lookups (api/_lib/places-api.js). Set in Vercel, not in git.
# GOOGLE_MAPS_API_KEY=
# Set to 1 to use Google for search suggestions, nearby places and geocoding (falls back to Mapbox).
# VITE_GOOGLE_PLACES=1
