# Copy to frontend/.env.test.local (git ignores it) and fill in from the TEST Supabase project.
# Never use the live project here: the tests refuse to run against it.
# Each run makes its own two throwaway accounts (made-up @example.com emails) and deletes them after.
TEST_SUPABASE_URL=https://your-test-project.supabase.co
TEST_SUPABASE_ANON_KEY=your_test_anon_key
TEST_SUPABASE_SERVICE_ROLE_KEY=your_test_service_role_key
