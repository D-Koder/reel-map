VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# Optional: a different iCloud link for the "Save to Reel Map" Shortcut. The app has a built-in one.
# VITE_SHORTCUT_URL=https://www.icloud.com/shortcuts/your-shortcut-id
# VITE_SHORTCUT_NAME=Save to Reel Map STG

# Optional: error reports from the app to Sentry (same DSN as SENTRY_DSN).
# VITE_SENTRY_DSN=

# Optional: "Connect Google Calendar" in Check Hours (suggests a time you're free). A Google Cloud OAuth client id
# (Web application), with this site's address under Authorized JavaScript origins and the Google Calendar API enabled.
# Leave it out and only the paste-a-link option shows.
# VITE_GOOGLE_CLIENT_ID=
